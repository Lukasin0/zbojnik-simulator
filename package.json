{
  "name": "zbojnik-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Zbojník Simulátor – low-poly 3D zbojnícke RPG z Liptova v prehliadači (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "deploy": "npm run build && npx netlify-cli deploy --prod --dir=dist"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/three": "0.160.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "5.4.10"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
